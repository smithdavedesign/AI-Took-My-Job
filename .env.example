# ─── RepoHQ Integration (Phase 46) ──────────────────────────────────────────
# Add these to Render → Environment → Environment Variables
#
# REPOHQ_WEBHOOK_URL    RepoHQ webhook endpoint (fires on PR created + merged)
# REPOHQ_WEBHOOK_SECRET Shared secret — must match NEXUS_WEBHOOK_SECRET in RepoHQ
#                       Generate: openssl rand -hex 32
# REPOHQ_MCP_DATABASE_URL  Neon connection string (same DATABASE_URL as RepoHQ)
#                           Enables rich portfolio context in .nexus/context.json
# REPOHQ_MCP_USER_ID    Your RepoHQ user UUID (find in Neon: SELECT id FROM users)
REPOHQ_WEBHOOK_URL=https://repohq.vercel.app/api/webhooks/agent-events
REPOHQ_WEBHOOK_SECRET=
REPOHQ_MCP_DATABASE_URL=
REPOHQ_MCP_USER_ID=0c52dc2a-aef1-4e8d-b2ff-0e1e5c261662

# ─── Agent execution command (pick one based on task risk tier) ───────────────
# Tier 1 docs/simple:  AGENT_EXECUTION_COMMAND=npx claude --dangerously-skip-permissions --print
# Tier 2 deps/CI:      AGENT_EXECUTION_COMMAND=./scripts/gstack-ship.sh
# Tier 3 security:     AGENT_EXECUTION_COMMAND=./scripts/gstack-investigate.sh
AGENT_EXECUTION_COMMAND=./scripts/gstack-ship.sh

# ─── OpenClaw Integration (Phase 57) ─────────────────────────────────────────
# Set OPENCLAW_LOCAL=true to route skill execution through `openclaw agent --local`
# instead of the bare claude CLI. Requires `openclaw` in PATH (install: openclaw.ai).
# Provides memory persistence and session context between runs on the same repo.
# When false (default), falls back to bare claude CLI — fully backwards-compatible.
# NOTE: Run the worker locally (not on Render) when using OpenClaw, since openclaw
# is a local-first tool. Connect to Render Redis via REDIS_URL for queue durability.
OPENCLAW_LOCAL=false
# OPENCLAW_GATEWAY_TOKEN=   # Shared token for `openclaw gateway --auth token` (optional)
#
# Auth pre-requisites (run once on the worker machine before enabling OPENCLAW_LOCAL):
#   1. claude auth login          # authenticate the Claude CLI
#   2. openclaw models auth login --provider anthropic --method cli --set-default
#   openclaw --local uses the claude-cli provider, which calls the same `claude` binary
#   that the gstack scripts already use. If `claude /skill` works, openclaw will too.
#   The scripts check `command -v claude` as a proxy for auth readiness.
